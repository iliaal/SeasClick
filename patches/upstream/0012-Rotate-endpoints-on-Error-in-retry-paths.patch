From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilia Alshanetsky <ilia@ilia.ws>
Date: Thu, 3 Sep 2026 10:00:00 -0400
Subject: [PATCH 12/13] Rotate endpoints on Error in retry paths

CreateConnection() and both RetryGuard loops catch only
std::system_error, so a malformed handshake (ProtocolError) or a
rejected TLS certificate (OpenSSLError) reached mid-session aborts
rotation and leaves current_endpoint_ pointing at the bad peer.
Patch 0002 fixed ResetConnectionEndpoint() the same way; extend the
same `catch (const Error&)` treatment to the three remaining
rotation sites. Server-side query errors still propagate: mid-query
ServerExceptions are caught by the caller's ServerException branch
before any reset runs.
---
 clickhouse/client.cpp | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/clickhouse/client.cpp b/clickhouse/client.cpp
--- a/clickhouse/client.cpp
+++ b/clickhouse/client.cpp
@@ -702,6 +706,14 @@ void Client::Impl::CreateConnection() {
             {
                 throw;
             }
+        } catch (const Error&) {
+            // Same rotation as above: a malformed handshake (ProtocolError)
+            // or a rejected TLS certificate (OpenSSLError) from every
+            // endpoint must exhaust attempts, not abort the first one.
+            if (++i >= max_attempts)
+            {
+                throw;
+            }
         }
     }
 }
@@ -1298,6 +1310,23 @@ void Client::Impl::RetryGuard(std::function<void()> func) {
                     ok = false;
                 }

+                if (!ok && i == options_.send_retries) {
+                    break;
+                }
+            } catch (const Error&) {
+                // A malformed peer reached mid-session throws ProtocolError
+                // (or OpenSSLError on cert rotation), not std::system_error.
+                // Recover the same way instead of aborting rotation with
+                // current_endpoint_ stuck on the bad peer.
+                bool ok = true;
+
+                try {
+                    socket_factory_->sleepFor(options_.retry_timeout);
+                    ResetConnection();
+                } catch (...) {
+                    ok = false;
+                }
+
                 if (!ok && i == options_.send_retries) {
                     break;
                 }
@@ -1322,6 +1351,13 @@ void Client::Impl::RetryGuard(std::function<void()> func) {
                 current_endpoint_.reset();
                 throw;
             }
+        } catch (const Error&) {
+            // Same rotation as above for non-transport Errors.
+            if (++i == connection_attempts_count)
+            {
+                current_endpoint_.reset();
+                throw;
+            }
         }
     }
 }
